<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Iso2Hd.AboutPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="16">
            <Image Source="Assets/AboutIcon.png" Width="64" Height="64" />
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="NameText" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                <TextBlock x:Name="ReleaseText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <TextBlock TextWrapping="Wrap"
                   Text="Writes .iso disc images to hard drives, SSDs and USB drives with the same sector layout a CD/DVD burning program puts on a disc, so vintage BIOS (non-UEFI) PCs can boot from them. Install discs that only boot from a CD get a BIOS boot record where ISO2HD has a fix for them." />

        <Button Click="GitHub_Click" AutomationProperties.Name="View on GitHub"
                ToolTipService.ToolTip="Open the project page in your browser">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                <TextBlock Text="View on GitHub" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
