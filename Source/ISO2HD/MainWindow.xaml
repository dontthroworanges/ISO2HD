<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Iso2Hd.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Iso2Hd"
    Title="ISO2HD">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (caption buttons follow the light/dark theme) -->
        <Grid x:Name="AppTitleBar" Height="48">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/TitleBarIcon.png" Width="16" Height="16" />
                <TextBlock Text="ISO2HD" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentGrid" Grid.Row="1" Padding="24,4,24,24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Image to write -->
            <StackPanel x:Name="ImageSection" Spacing="8" SizeChanged="Section_SizeChanged">
                <TextBlock Text="Disc image" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="IsoBox" PlaceholderText="The .iso or .img file to write"
                             LostFocus="IsoBox_LostFocus" KeyDown="IsoBox_KeyDown" />
                    <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Click="Browse_Click"
                            ToolTipService.ToolTip="Choose a disc image" />
                </Grid>
                <TextBlock x:Name="IsoInfoText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" Text="No image selected." />
                <TextBlock x:Name="IsoWarningText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- Drive to write to -->
            <StackPanel x:Name="DriveSection" Grid.Row="1" Spacing="8" SizeChanged="Section_SizeChanged">
                <TextBlock Text="Target drive" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="DiskBox" HorizontalAlignment="Stretch" PlaceholderText="Choose the drive to write to"
                              SelectionChanged="DiskBox_SelectionChanged" />
                    <Button x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click" AutomationProperties.Name="Refresh"
                            ToolTipService.ToolTip="Scan for drives again">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock x:Name="DiskInfoText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Actions and progress -->
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- AutomationProperties.Name: icon + text content doesn't give buttons an accessible name -->
                <Button x:Name="AboutButton" Click="About_Click" AutomationProperties.Name="About" ToolTipService.ToolTip="About this app">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                        <TextBlock Text="About" />
                    </StackPanel>
                </Button>
                <Button x:Name="PrefsButton" Grid.Column="1" Click="Preferences_Click" AutomationProperties.Name="Preferences"
                        ToolTipService.ToolTip="Preferences">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                        <TextBlock Text="Preferences" />
                    </StackPanel>
                </Button>
                <!-- Burn, and Cancel while a write is running -->
                <Button x:Name="StartButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="StartCancel_Click" MinWidth="110"
                        AutomationProperties.Name="Burn">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="StartIcon" Glyph="&#xE768;" FontSize="14" />
                        <TextBlock x:Name="StartText" Text="Burn" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="3" Margin="16,0" VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" Text="Ready"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="Progress" Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="OutputToggleButton" Grid.Column="4" Click="ToggleOutput_Click" MinWidth="130"
                        AutomationProperties.Name="Hide output" ToolTipService.ToolTip="Show or hide the output">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="OutputToggleIcon" Glyph="&#xE70E;" FontSize="14" />
                        <TextBlock x:Name="OutputToggleText" Text="Hide output" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Output -->
            <Grid x:Name="OutputPanel" Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,8,8,8">
                    <TextBlock Text="Output" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" Click="CopyOutput_Click"
                            AutomationProperties.Name="Copy" ToolTipService.ToolTip="Copy all output to the clipboard">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            <TextBlock Text="Copy" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ListView x:Name="LogList" Grid.Row="1" SelectionMode="None" Padding="0,0,0,8">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="16,1" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:LogLine">
                            <TextBlock Text="{x:Bind Text}" Foreground="{x:Bind Foreground}" FontFamily="Cascadia Mono, Consolas"
                                       FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Window>
